# Examples only; process environment is read, dotenv is not loaded automatically.
FINGUARD_INFERENCE_ROOT=/path/to/approved/private/portable-models
FINGUARD_ENV=local
FINGUARD_ALLOWED_HOSTS=localhost,127.0.0.1
FINGUARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FINGUARD_REQUESTS_PER_MINUTE=120
PORT=8000
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
PYTHONDONTWRITEBYTECODE=1
# Alternative to INFERENCE_ROOT: provider-managed, fixed-name private files.
# FINGUARD_SECRET_FILES_DIR=/etc/secrets
