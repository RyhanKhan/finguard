# Replace the example domains with the actual assigned backend/frontend domains.
# Configure through Render's dashboard; do not put model contents in env vars.
FINGUARD_ENV=production
FINGUARD_ALLOWED_HOSTS=finguard-example.onrender.com
FINGUARD_CORS_ORIGINS=https://finguard-example.vercel.app
FINGUARD_SECRET_FILES_DIR=/etc/secrets
FINGUARD_REQUESTS_PER_MINUTE=120
PORT=10000
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
PYTHONDONTWRITEBYTECODE=1
